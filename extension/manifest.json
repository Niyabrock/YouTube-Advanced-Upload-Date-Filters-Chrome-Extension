{
  "manifest_version": 3,
  "name": "More YouTube Upload Dates",
  "version": "1.0.3",
  "description": "Calendar and custom date searches in YouTube\u2019s native interface. Native date operators are experimental.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "dates.js",
        "search.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ]
    }
  ]
}
